{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/eulawmeter/:path*",
      "destination": "https://eulawscanner.vercel.app/:path*"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/pnc",
      "destination": "/pnc/index.html"
    },
    {
      "source": "/criticisms",
      "destination": "/criticisms/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/methodology",
      "destination": "/methodology/index.html"
    }
  ]
}
