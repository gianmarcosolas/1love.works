.nav-links a { font-family: var(--mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); text-decoration: none; transition: color 0.2s; }
.nav-links a:hover { color: var(--ink); }
.lang-switcher { display: flex; border: 1px solid var(--rule); overflow: hidden; }
.lang-btn { font-family: var(--mono); font-size: 10px; padding: 5px 9px; border: none; background: transparent; color: var(--muted); cursor: pointer; border-right: 1px solid var(--rule); transition: all 0.15s; }
.lang-btn:last-child { border-right: none; }
.lang-btn.active { background: var(--ink); color: var(--parchment); }
.lang-btn:hover:not(.active) { background: var(--cream); }

.hero { max-width: 760px; margin: 0 auto; padding: 48px 48px 40px; border-bottom: 1px solid var(--rule); }
.back-link { font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); text-decoration: none; }
