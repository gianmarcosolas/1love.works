// ── Identical seeded computation to index.html / the simulation page, so λ NUP values match exactly ──
var SARD=SRAW.map(function(r,i){
  var prov=r[0],name=r[1],pop=r[2],trend=r[3];
  var s=i*137+name.charCodeAt(0);
  function sr(){s=(s*1664525+1013904223)&0xFFFFFFFF;return(s>>>0)/4294967296;}
  var sem,ent;
  if(trend<=-30||(trend<=-20&&pop<2000)){sem="🔴";ent=60+Math.floor(sr()*25);}
  else if(trend<=-8||(trend<0&&pop<5000)){sem="🟡";ent=35+Math.floor(sr()*25);}
  else{sem="🟢";ent=10+Math.floor(sr()*20);}
  var base=pop*(sem==="🔴"?28:sem==="🟡"?22:16)/1000;
  var tot=Math.max(0.5,+(base*(0.8+sr()*0.4)).toFixed(1));
  return {prov:prov,name:name,pop:pop,trend:trend,sem:sem,nup:tot,ent:ent,
    slug:name.toLowerCase().replace(/'/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,''),
    code:'eu.it.sardegna.'+prov.toLowerCase()+'.'+name.toLowerCase().replace(/'/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'')};
});

function fEur(v){
  if(v>=1000)return"€"+(v/1000).toFixed(2)+"B";
  return"€"+v.toFixed(1)+"M";
}
function fPop(p){return p.toLocaleString('de-DE');}

