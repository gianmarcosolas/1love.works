.section h2 { font-size: clamp(22px, 3.4vw, 30px); font-weight: 400; line-height: 1.2; margin-bottom: 16px; }
.section p { font-size: 17px; color: #3a3a36; line-height: 1.85; margin-bottom: 16px; }
.section p:last-of-type { margin-bottom: 0; }
.section p a { color: var(--gold); }

.dashboard { background: var(--ink); color: var(--parchment); padding: 32px; }
.dashboard-title { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.15em; color: rgba(245,242,234,0.5); margin-bottom: 20px; }
.dashboard-note { font-family: var(--mono); font-size: 11px; color: rgba(245,242,234,0.4); margin-top: 18px; font-style: italic; }
.d-kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2px; background: rgba(245,242,234,0.1); }
.d-kpi { background: var(--ink); padding: 14px 16px; }
.d-kpi .l { font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(245,242,234,0.4); margin-bottom: 6px; }
.d-kpi .v { font-family: var(--mono); font-size: 20px; font-weight: 500; color: var(--gold); }
.d-kpi .v.status-open { color: var(--gold); }
.d-kpi .v.status-claimed { color: #8fd18f; }

.notice-box { border: 1px solid var(--rule-med); border-left: 4px solid var(--gold); padding: 22px 26px; background: var(--white); }
.notice-box.masullas { border-left-color: #2d6a2d; }
.notice-box h3 { font-size: 19px; font-weight: 500; margin-bottom: 10px; }
.notice-box p { font-size: 16px; color: #3a3a36; line-height: 1.8; margin-bottom: 14px; }
.notice-box p:last-of-type { margin-bottom: 0; }

.cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
.cta-row a, .cta-row button {
