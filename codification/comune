function loadClaimStatus(){
  if (!comune) return;
  fetch(SUPABASE_URL+'/rest/v1/pnc_holders?select=territory_code&territory_code=eq.'+encodeURIComponent(comune.code),
    {headers:{apikey:SUPABASE_KEY,Authorization:'Bearer '+SUPABASE_KEY}})
    .then(function(r){return r.json();})
    .then(function(data){
      claimedState = (Array.isArray(data) && data.length > 0) ? 'claimed' : 'open';
      renderComune();
    })
    .catch(function(){ claimedState = 'open'; renderComune(); });
}

