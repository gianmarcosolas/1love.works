.cta-row a.primary, .cta-row button.primary { background: var(--gold); color: var(--ink); }
.cta-row a.secondary { background: transparent; color: var(--ink); border: 1px solid var(--rule-med); }

.claimed-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: #2d6a2d; background: rgba(45,106,45,0.08); border: 1px solid rgba(45,106,45,0.25); padding: 8px 14px; margin-bottom: 16px; }

footer { max-width: 900px; margin: 0 auto; padding: 32px 48px 56px; font-family: var(--mono); font-size: 11px; color: var(--muted); }

