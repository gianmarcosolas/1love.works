<script>
  const SUPABASE_URL = 'https://pwrcqepqhtuesoximmoj.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB3cmNxZXBxaHR1ZXNveGltbW9qIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYwNjg2MTMsImV4cCI6MjA5MTY0NDYxM30.tO5SFloOfMZULDHtFII2dilE10fUk8SLCpmyHiCNidE';

  async function submitToSupabase(payload) {
    const res = await fetch(`${SUPABASE_URL}/rest/v1/love_submissions`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_ANON_KEY,
        'Authorization': `Bearer ${SUPABASE_ANON_KEY}`,
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify(payload)
    });
    if (!res.ok && res.status !== 201) throw new Error(res.status);
    return res;
  }

  // Free interest form
  document.getElementById('freeForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('freeSubmitBtn');
    btn.disabled = true;
    btn.textContent = 'Submitting…';

    const interests = Array.from(document.querySelectorAll('input[name="f-interest"]:checked'))
      .map(cb => cb.value).join(', ');
    const notes = document.getElementById('f-notes').value;

    const payload = {
      email: document.getElementById('f-email').value || null,
      language: document.getElementById('f-language').value || null,
      country: document.getElementById('f-country').value || null,
      region: document.getElementById('f-region').value || null,
      city: document.getElementById('f-city').value || null,
      interest_type: [interests, notes ? 'notes: ' + notes : ''].filter(Boolean).join(' | ') || 'manifest_interest',
      paid: false
    };

    try {
      await submitToSupabase(payload);
      document.getElementById('freeForm').style.display = 'none';
      document.getElementById('freeSuccessMsg').classList.add('show');
    } catch {
      document.getElementById('freeErrorMsg').classList.add('show');
      btn.disabled = false;
      btn.textContent = 'Manifest interest →';
    }
  });
</script>

